#!/usr/bin/env bash
#
# Install with `just hooks-install` (copies this file to .git/hooks/pre-commit).
#
# This lives under version control on purpose. It used to exist only in
# .git/hooks, which no clone carries and no review ever sees — so when the
# backend drifted 21 files out of gofmt, nothing anywhere in the repo recorded
# that a gate was supposed to exist. Formatting itself is enforced by the
# `formatters:` block in backend/.golangci.yml, which `golangci-lint run`
# below reports on; keeping it there means the rule survives even if the hook
# is not installed.
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

failed=0

# Tracker IDs must not enter the codebase.
#
# CLAUDE.md: source files are not historical documents. A comment citing a
# ticket is a dangling pointer — issues close, tombstone and get superseded —
# and it outsources the comment's job to something the reader must look up.
#
# Enforced by grep rather than by golangci-lint: forbidigo inspects identifiers
# and call expressions, not comment text, so a forbidigo pattern here matches
# nothing (verified). The exclusions are real tokens that merely look like issue
# ids: TLS SANs, a gRPC metadata header, a certificate subject, a log-file name
# prefix, and a blobstore reachability probe key. Requiring a digit would be a
# tempting shortcut but is wrong —
# 55 real issue ids have none. Add to the list when a new code token collides.
#
# Both vocabulary checks scan the WHOLE tree, not just the staged diff. A
# staged-only gate can only see files you are currently touching, so a file
# that loses its fix — a bad `git checkout --`, a botched merge resolution, a
# rebase dropping a hunk — has no staged change and passes unseen. That is not
# hypothetical: it is how two `tier` comments reached main after the sweep that
# removed them reported clean. Both counts are zero, so a whole-tree scan costs
# one git grep and can never be satisfied by not touching the file.
SRC_PATHS=$(printf "%s " '*.go' '*.ts' '*.tsx' ':!*/gen/*')
if true; then
  printf "Checking for tracker IDs in source... "
  HITS=$(git grep -nE 'gastrolog-[a-z0-9]{4,}' -- $SRC_PATHS 2>/dev/null \
    | grep -vE 'gastrolog-(raft|cluster|node|test|lifecycle|connection)\b' || true)
  if [ -z "$HITS" ]; then
    printf "${GREEN}ok${NC}\n"
  else
    printf "${RED}FAILED${NC}\n"
    echo "  Tracker IDs belong in COMMIT MESSAGES ONLY. Put the reason in the comment:"
    echo "$HITS" | sed 's/^/    /' | head -20
    failed=1
  fi
fi

# "Tier" must not enter the codebase in our own voice.
#
# Hot/cold storage layering is a rejected design, and the word is the vector:
# it reads as a standing concept, so the next writer reaches for it and then
# designs to it. See the banned row in docs/ubiquitous_language.md for the
# canonical replacements — fallback, threshold, cloud storage class.
#
# Only provider API surface is exempt, and only where the identifier is theirs
# and cannot be renamed. That is why the exclusion matches the SDK spellings
# (AccessTier, SetTier, SetBlobTier, types.Tier, INTELLIGENT_TIERING) rather
# than whole files: a blobstore adapter may call Azure's SetTier and still not
# describe our own behaviour as tiered.
if true; then
  printf "Checking for banned 'tier' vocabulary... "
  TIER=$(git grep -inE 'tier' -- $SRC_PATHS 2>/dev/null \
    | grep -viE 'frontier|AccessTier|SetTier|SetBlobTier|types\.Tier|INTELLIGENT_TIERING' || true)
  if [ -z "$TIER" ]; then
    printf "${GREEN}ok${NC}\n"
  else
    printf "${RED}FAILED${NC}\n"
    echo "  GastroLog has no tiers. Use fallback / threshold / cloud storage class:"
    echo "$TIER" | sed 's/^/    /' | head -20
    failed=1
  fi
fi

# Proto: generated code must match the .proto it came from.
#
# A partial regeneration is invisible to every other gate: the stale generated
# file is self-consistent, so tsc and the test suites compile happily against
# the OLD field names while the wire format has already moved. That is exactly
# how the storage_class -> cloud_storage_class rename reached main-bound review
# with a frontend that would have read undefined at runtime.
if git diff --cached --name-only | grep -q '\.proto$'; then
  printf "Checking generated code is in sync... "
  if just gen > /dev/null 2>&1 && git diff --quiet -- backend/api/gen frontend/src/api/gen; then
    printf "${GREEN}ok${NC}\n"
  else
    printf "${RED}FAILED${NC}\n"
    echo "  .proto changed but generated output differs. Run 'just gen' and stage the result:"
    git diff --name-only -- backend/api/gen frontend/src/api/gen | sed 's/^/    /'
    failed=1
  fi
fi

# Backend: golangci-lint
if git diff --cached --name-only | grep -q '^backend/'; then
  printf "Running golangci-lint... "
  if (cd backend && golangci-lint run ./...) > /dev/null 2>&1; then
    printf "${GREEN}ok${NC}\n"
  else
    printf "${RED}FAILED${NC}\n"
    (cd backend && golangci-lint run ./...) 2>&1 | head -30
    failed=1
  fi
fi

# Frontend: tsc + eslint
if git diff --cached --name-only | grep -q '^frontend/'; then
  printf "Running tsc... "
  if (cd frontend && bunx tsc --noEmit) > /dev/null 2>&1; then
    printf "${GREEN}ok${NC}\n"
  else
    printf "${RED}FAILED${NC}\n"
    (cd frontend && bunx tsc --noEmit) 2>&1 | head -30
    failed=1
  fi

  printf "Running eslint... "
  if (cd frontend && bun run lint) > /dev/null 2>&1; then
    printf "${GREEN}ok${NC}\n"
  else
    printf "${RED}FAILED${NC}\n"
    (cd frontend && bun run lint) 2>&1 | head -30
    failed=1
  fi
fi

if [ "$failed" -ne 0 ]; then
  printf "\n${RED}Pre-commit checks failed. Fix the issues above before committing.${NC}\n"
  exit 1
fi

set dotenv-load

# Lists all available backend commands.
_default:
  @just --list

version := `git describe --tags --always --dirty 2>/dev/null || echo dev`
build_dir := "../build"

# Builds the gastrolog binary (build/gastrolog at repo root).
build:
  mkdir -p {{build_dir}}
  go build -ldflags "-X main.version={{version}}" -o {{build_dir}}/gastrolog ./cmd/gastrolog

# Remove build/ output.
clean:
  rm -rf {{build_dir}}

# Runs the gastrolog backend with raft config (default).
run-raft:
  go run ./cmd/gastrolog server --home "${GLOG_DATA_DIR:-data}"

# Runs the gastrolog backend with in-memory config (no persistence).
run-memory:
  go run ./cmd/gastrolog server --config-type memory

alias run := run-raft

# Runs the gastrolog backend with full bootstrap (memory store + chatterbox).
run-bootstrap:
  go run ./cmd/gastrolog server --bootstrap --home "${GLOG_DATA_DIR:-data}"

# Runs the gastrolog backend with authentication disabled (all requests treated as admin).
run-noauth:
  go run ./cmd/gastrolog server --no-auth --home "${GLOG_DATA_DIR:-data}"

# Runs the gastrolog backend with pprof server and debug sampling (mutex/block).
pprof:
  go run ./cmd/gastrolog server --home "${GLOG_DATA_DIR:-data}" --pprof localhost:6060 --pprof-debug

# Runs a config CLI command against the local server. Usage: just cfg filter list
conf *args:
  go run ./cmd/gastrolog --home "${GLOG_DATA_DIR:-data}" config {{args}}

# Runs a query against node 1. Usage: just query 'level=error last=5m' --limit 10
query +args:
  go run ./cmd/gastrolog --home "${GLOG_DATA_DIR:-/tmp/gastrolog}/node1" query {{args}}

# Cross-compiles for a specific OS/arch. Usage: just build-cross linux amd64
build-cross os arch:
  mkdir -p {{build_dir}}
  CGO_ENABLED=0 GOOS={{os}} GOARCH={{arch}} go build -ldflags "-X main.version={{version}}" -o {{build_dir}}/gastrolog-{{os}}-{{arch}} ./cmd/gastrolog

# Builds release binaries for all supported platforms.
build-all:
  just build-cross linux amd64
  just build-cross linux arm64
  just build-cross darwin amd64
  just build-cross darwin arm64

# Generates Go protobuf code from proto definitions.
gen:
  cd api/proto && buf generate

# Fast developer-loop tests: skips multi-second convergence/stress/large-I/O
# tests behind testing.Short() (down from ~93s unsharded — gastrolog-3241bv).
# Run this during development. ~48s wall on a 16-core dev box.
test *args:
  go test -short ./... {{args}}

# Full acceptance gate: runs every test, including the ones -short skips
# (multi-node raft convergence, WAL stress/large-segment I/O, restart-survival
# cycles — gastrolog-3241bv). Run once before declaring work done / handoff.
# ~90s+ wall on a 16-core dev box.
test-full *args:
  go test ./... {{args}}

# Runs the reliability-matrix tests: vaultraft FSM scenarios, orchestrator-
# backed end-to-end scenarios, and the targeted 5oofa regressions. Use
# before cutting a release or after any change to orchestrator / cluster
# / multiraft / vaultraft. Each scenario exercises a different failure
# axis (pause, slow, restart, wipe, partition, leader kill, stress).
test-reliability *args:
  #!/usr/bin/env bash
  set -euo pipefail
  echo "=== vaultraft reliability matrix ==="
  go test -run 'TestReliability_' -count=1 -timeout 300s ./internal/vaultraft/ {{args}}
  echo "=== orchestrator-backed reliability matrix ==="
  go test -run 'TestOrchRel_' -count=1 -timeout 600s ./internal/orchestrator/ {{args}}
  echo "=== 5oofa lock + ctx regressions ==="
  go test -run 'TestReliability_Ingest_|TestRunWithCtx_' -count=1 -timeout 60s ./internal/orchestrator/ ./internal/cluster/ {{args}}

# Runs the reliability-matrix tests multiple times to catch flakes.
# Count defaults to 5 — override with COUNT=10 etc.
test-reliability-flake COUNT='5':
  #!/usr/bin/env bash
  set -euo pipefail
  echo "=== vaultraft reliability matrix ({{COUNT}}x) ==="
  go test -run 'TestReliability_' -count={{COUNT}} -timeout 600s ./internal/vaultraft/
  echo "=== orchestrator reliability matrix ({{COUNT}}x) ==="
  # Budget: ~5s per test × 11 tests × {{COUNT}} iterations × 2x safety = ~110s per iteration.
  # Default 1800s covers 5x comfortably; bump if COUNT is large.
  go test -run 'TestOrchRel_' -count={{COUNT}} -timeout 1800s ./internal/orchestrator/ -parallel 4

# Lints Go code (cognitive complexity, cyclomatic complexity, gocritic).
lint:
  golangci-lint run ./...

# Full backend quality audit: lint, vet, race tests, vulnerability scan, dead code.
audit:
  #!/usr/bin/env bash
  set -euo pipefail
  echo "=== golangci-lint ==="
  golangci-lint run ./...
  echo "=== go vet ==="
  go vet ./...
  echo "=== go test -race ==="
  go test -race -count=1 ./...
  echo "=== govulncheck ==="
  go run golang.org/x/vuln/cmd/govulncheck@latest ./...
  echo "=== deadcode ==="
  go run golang.org/x/tools/cmd/deadcode@latest ./...

# --- Cluster development recipes ---


# Runs an existing 4-node cluster. No init, no configuration.
cluster-run:
  ../scripts/cluster.sh run

# Runs an existing 4-node cluster with full pprof (6060-6063, mutex/block/trace).
cluster-run-pprof:
  ../scripts/cluster.sh run --pprof

# Bootstraps a fresh 4-node cluster from scratch.
# Starts all nodes, enrolls them, configures storage/policies/vault/ingesters.
# Runs in the foreground — Ctrl-C stops everything.
cluster-init:
  ../scripts/cluster.sh init

# Kills all stuck gastrolog cluster processes.
cluster-kill:
  #!/usr/bin/env bash
  data_dir="${GLOG_DATA_DIR:-/tmp/gastrolog}"
  pkill -INT -f "gastrolog.*--home ${data_dir}/node" 2>/dev/null || true
  sleep 2
  pkill -KILL -f "gastrolog.*--home ${data_dir}/node" 2>/dev/null || true
  pkill -KILL -f 'imux.*gastrolog' 2>/dev/null || true
  echo "Cluster processes killed."

# Dumps heap profile for a node and shows top allocators. Usage: just heap-profile 1
heap-profile node="1":
  #!/usr/bin/env bash
  port=$((6059 + {{node}}))
  curl -s "http://localhost:${port}/debug/pprof/heap" -o "/tmp/gastrolog-node{{node}}-heap.prof" && go tool pprof -top "/tmp/gastrolog-node{{node}}-heap.prof"

# CPU profile for N seconds. Usage: just cpu-profile 4 30
cpu-profile node="1" seconds="30":
  #!/usr/bin/env bash
  port=$((6059 + {{node}}))
  out="/tmp/gastrolog-node{{node}}-cpu.prof"
  curl -s "http://localhost:${port}/debug/pprof/profile?seconds={{seconds}}" -o "$out"
  go tool pprof -top "$out"

# Goroutine profile. Usage: just goroutine-profile 3
goroutine-profile node="1":
  #!/usr/bin/env bash
  port=$((6059 + {{node}}))
  out="/tmp/gastrolog-node{{node}}-goroutine.prof"
  curl -s "http://localhost:${port}/debug/pprof/goroutine" -o "$out"
  go tool pprof -top -cum "$out"

# Mutex contention profile (requires --pprof-debug or --pprof-mutex-fraction). Usage: just mutex-profile 4
mutex-profile node="1":
  #!/usr/bin/env bash
  port=$((6059 + {{node}}))
  out="/tmp/gastrolog-node{{node}}-mutex.prof"
  curl -s "http://localhost:${port}/debug/pprof/mutex" -o "$out"
  go tool pprof -top -cum "$out"

# Block profile (requires --pprof-debug or --pprof-block-rate). Usage: just block-profile 3
block-profile node="1":
  #!/usr/bin/env bash
  port=$((6059 + {{node}}))
  out="/tmp/gastrolog-node{{node}}-block.prof"
  curl -s "http://localhost:${port}/debug/pprof/block" -o "$out"
  go tool pprof -top -cum "$out"

# Execution trace. Usage: just trace-profile 3 5
trace-profile node="1" seconds="5":
  #!/usr/bin/env bash
  port=$((6059 + {{node}}))
  out="/tmp/gastrolog-node{{node}}.trace"
  curl -s "http://localhost:${port}/debug/pprof/trace?seconds={{seconds}}" -o "$out"
  echo "saved $out — open with: go tool trace $out"

# Capture CPU, goroutine, mutex, block, and trace in one shot during an incident.
# Usage: just pprof-capture 4 30 5
pprof-capture node="4" cpu_seconds="30" trace_seconds="5":
  #!/usr/bin/env bash
  set -euo pipefail
  port=$((6059 + {{node}}))
  base="/tmp/gastrolog-node{{node}}"
  echo "capturing from localhost:${port} ..."
  curl -s "http://localhost:${port}/debug/pprof/profile?seconds={{cpu_seconds}}" -o "${base}-cpu.prof"
  curl -s "http://localhost:${port}/debug/pprof/goroutine" -o "${base}-goroutine.prof"
  curl -s "http://localhost:${port}/debug/pprof/mutex" -o "${base}-mutex.prof"
  curl -s "http://localhost:${port}/debug/pprof/block" -o "${base}-block.prof"
  curl -s "http://localhost:${port}/debug/pprof/trace?seconds={{trace_seconds}}" -o "${base}.trace"
  echo "saved:"
  ls -lh "${base}"*.prof "${base}.trace"
  echo "inspect: go tool pprof -http=:0 ${base}-cpu.prof"
  echo "trace:   go tool trace ${base}.trace"

# --- End cluster recipes ---

# Embeds built frontend assets into the backend (brotli-compressed).
embed-frontend:
  rm -rf internal/frontend/dist/*
  cp -r ../frontend/dist/* internal/frontend/dist/
  go run ./cmd/compress-assets internal/frontend/dist
